{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": false,
    "types": []
  },
  "include": ["app/**/*", "engine/**/*", "workers/**/*", "types/**/*", "engine.js", "typcheck/**/*"],
  "exclude": ["node_modules", "tests", "scripts", "docs", "src-tauri"]
}
